{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git push origin main",
            "if": "Bash(git commit *)",
            "timeout": 120,
            "statusMessage": "Auto-pushing to GitHub..."
          }
        ]
      }
    ]
  }
}
